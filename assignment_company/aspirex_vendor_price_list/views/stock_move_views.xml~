<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_manufacturer" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.manufacturer_id</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="before">
                <field name="manufacturer_id" placeholder="Select Manufacturer"/>
                <field name="manufacturer_part_number" placeholder="Manufacturer Part Number"/>
                <field name="vendor_part_number" placeholder="Vendor Part Number"/>
                <field name="vendor_part_name" placeholder="Vendor Part Name"/>
            </xpath>

            <xpath expr="//list//field[@name='product_id']" position="before">
                <field name="item"/>
            </xpath>
        </field>
    </record>
</odoo>
