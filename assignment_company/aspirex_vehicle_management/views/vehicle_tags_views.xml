<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vehicle_tags_list_view" model="ir.ui.view">
        <field name="name">vehicle.tags.list</field>
        <field name="model">vehicle.tags</field>
        <field name="arch" type="xml">
            <list string="Vehicle Tags" limit="25" >
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="vehicle_tags_form_view" model="ir.ui.view">
        <field name="name">vehicle.tags.form</field>
        <field name="model">vehicle.tags</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="colour" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vehicle_tags_action" model="ir.actions.act_window">
        <field name="name">Vehicle Tags</field>
        <field name="res_model">vehicle.tags</field>
        <field name="view_mode">list,form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="vehicle_tags_list_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vehicle Tags
            </p>
        </field>
    </record>

    <menuitem id="menu_vehicle_tags" name='Vehicle tags' sequence="1" parent="menu_configuration"
              action="vehicle_tags_action">
    </menuitem>
</odoo>