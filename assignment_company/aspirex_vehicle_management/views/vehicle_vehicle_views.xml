<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="vehicle_vehicle_list_view" model="ir.ui.view">
        <field name="name">vehicle.vehicle.list</field>
        <field name="model">vehicle.vehicle</field> <!--our model name -->
        <field name="arch" type="xml">
            <list string="vehicle Information" limit="25">
                <field name="priority1" widget="priority"/>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="fuel_type"/>
                <field name="year"/>
                <field name="register_year"/>
                <field name="owner_id"/>
                <field name="purchase_date"/>
                <field name="is_leave" widget="boolean_toggle"/>  <!-- boolean toggle is the radio button -->
                <field name="state"
                       decoration-success="state == 'confirm'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'cancel'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="vehicle_vehicle_search_view" model="ir.ui.view">
        <field name="name">vehicle.vehicle.search</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <!-- General Search: Name, License Plate, fuel
                -type, model and Brand -->
                <field name="name"
                       filter_domain="['|', '|', ('model', 'ilike', self), ('license_plate', 'ilike', self), ('fuel_type', 'ilike', self)]"/>
                <field name="license_plate"/>
                <field name="fuel_type"/>
                <field name="model"/>
                <field name="brand"/>
                <filter name="filter_active" string="Archive" domain="[('active', '=', False)]"/>

                <!-- Fuel Type Filters -->
                <filter name="filter_petrol" string="Fuel Petrol" domain="[('fuel_type', '=', 'petrol')]"/>
                <filter name="filter_diesel" string="Fuel Diesel" domain="[('fuel_type', '=', 'diesel')]"/>

                <separator/>

                <!-- Register Year Filter -->
                <filter name="filter_recent_models" string="Recent Models" domain="[('register_year', '&gt;', 2016)]"/>
                <!-- &lt; -> less than and 	&gt; -> greater than -->

                <!-- Group By Options -->
                <group>
                    <filter name="group_by_fuel_type" string="Fuel Type" context="{'group_by': 'fuel_type'}"/>
                </group>

                <!-- Purchase Date Filters by Months -->   <!-- context_today() it gets the current date -->
                <!-- subtracts 1 month from today. -->
                <filter name="filter_recent_purchase_1_month" string="Last Month"
                        domain="[('purchase_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>

                <filter name="filter_recent_purchase_3_months" string="Last 3 Months"
                        domain="[('purchase_date', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>

                <filter name="filter_recent_purchase_6_months" string="Last 6 Months"
                        domain="[('purchase_date', '&gt;=', (context_today() - relativedelta(months=6)).strftime('%Y-%m-%d'))]"/>

                <separator string="Purchase Year Filters"/>

                <!-- Purchase Date Filters by Year -->
                <filter name="filter_purchase_2025" string="2025"
                        domain="[('purchase_date', '&gt;=', '2025-01-01'), ('purchase_date', '&lt;=', '2025-12-31')]"/>

                <filter name="filter_purchase_2024" string="2024"
                        domain="[('purchase_date', '&gt;=', '2024-01-01'), ('purchase_date', '&lt;=', '2024-12-31')]"/>

                <filter name="filter_purchase_2023" string="2023"
                        domain="[('purchase_date', '&gt;=', '2023-01-01'), ('purchase_date', '&lt;=', '2023-12-31')]"/>

                <filter name="filter_purchase_2022" string="2022"
                        domain="[('purchase_date', '&gt;=', '2022-01-01'), ('purchase_date', '&lt;=', '2022-12-31')]"/>
                <!-- Search Panel -->
                <searchpanel>
                    <field name="fuel_type" select="multi" enable_counters="1" icon="fa-car"/>
                </searchpanel>
            </search>
        </field>
    </record>


    <!-- Form view -->
    <record id="vehicle_vehicle_form_view" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle Information">
                <header>
                    <button id="action_confirm" name="action_confirm" string="Confirm" class="btn-primary"
                            type="object" invisible="state != 'draft'" />
                    <button id="action_cancel" name="action_cancel" string="Cancel" class="btn-secondary"
                            type="object" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet string="Vehicle Information Form">
                    <h1 class="d-flex">
                    <field name="priority1" widget="priority"/>
                    </h1>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <span class="o_form_label">Vehicle Name</span>
                        <h1>
                            <field name="vehicleid"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <!-- <field name="active" invisible="1"/>
                            <field name="name"/> -->


                            <group>
                                <field name="license_plate"/>
                                <field name="brand"/>
                                <field name="model"/>
                                <field name="fuel_type"/>
                                <field name="currency_id"/>
                                <field name="course_fee"/>

                            </group>
                        </group>
                        <group>
                            <field name="is_leave" widget="boolean_toggle"/>
                            <field name="location" widget="radio" options="{'horizontal': true}"/>
                            <field name="city_name"/>
                            <field name="lecturer_id" widget="many2one_avatar"/>
                            <field name="vehicle_tags_ids" widget="many2many_tags" options="{'color_field': 'colour'}"/>

                        </group>
                    </group>
                    <notebook>
                        <page name ="Vehicle Information">
                            <group>
                                <group>
                                    <field name="year"/>
                                    <field name="owner_id" options="{'no_qick_create': True}"/>
                                    <field name="year_code"/>
                                    <!--Owner_id added -->
                                    <field name="register_year" widget="Integer"/>
                                    <field name="purchase_date"/>
                                    <field name="vehicle_age" />
                            </group>
                            </group>
                        </page>
                        <page string="Vehicle Drivers">
                            <field name="vehicle_vehicle_ids"> <!-- one to many field -->
                                    <list editable="bottom" string="Driver Information" open_form_view="True">
                                        <field name ="name"/>
                                        <field name = "age"/>
                                        <field name ="mobile"/>
                                        <field name = "email"/>
                                    </list>
                            <form>
                                <field name ="name"/>
                                <field name = "age"/>
                                <field name ="mobile"/>
                                <field name = "email"/>
                            </form>
                            </field>
                        </page>
                        <page name="Driving License">
                            <field name="license" filename="license_file_name" widget="pdf_viewer"/>
                        </page>
                        <page string="Remarks">

                            <field name="remark"/>

                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="vehicle_vehicle_kanban_view" model="ir.ui.view">
        <field name="name">vehicle.vehicle.kanban</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global">
                            <div class="oe_kanban_details">
                                <strong>
                                     <field name="priority1" widget="priority"/>
                                </strong>
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="license_plate"/>
                                </div>
                                <div>
                                    <field name="brand"/>
                                </div>
                                <div>
                                    <field name="model"/>
                                </div>
                                <div>
                                    <field name="year"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="vehicle_vehicle_view_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field> <!-- displaying after the new button -->
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="vehicle_vehicle_list_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vehicle Information
            </p>
        </field>
    </record>

    <!-- Menu Binding -->
    <menuitem id="menu_vehicle_vehicle" name="Vehicles" sequence="1" parent="menu_vehicle_information"
              action="vehicle_vehicle_view_action"/>
    <!-- This links the menu item to the previously defined action (student_student_view_action).
    When clicked, the student.
    student records will be shown in the defined views (list, form, kanban) -->
</odoo>
